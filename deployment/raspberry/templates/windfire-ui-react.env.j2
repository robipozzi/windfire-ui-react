# Managed by Ansible (templates/windfire-ui-react.env.j2) - local changes are overwritten on deploy
# Read by server.js at startup. The VITE_* values are already bundled into dist/ by deploy.sh:
# server.js only needs the two URLs below to build the Content-Security-Policy connect-src.

# Server Configuration
PORT={{ https_port }}
HTTP_REDIRECT={{ http_redirect }}

# SSL Configuration
SSL_KEY_FILE=ssl/{{ windfire_server_key }}
SSL_CRT_FILE=ssl/{{ windfire_server_certificate }}

# Content-Security-Policy connect-src origins
VITE_KEYCLOAK_URL={{ vite_keycloak_url }}
VITE_RESTAURANTS_URL={{ vite_restaurants_url }}
