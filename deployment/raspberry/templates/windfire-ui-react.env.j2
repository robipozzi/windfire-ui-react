# Managed by Ansible (templates/windfire-ui-react.env.j2) - local changes are overwritten on deploy
# Read by server.js at startup. The REACT_APP_* values are already bundled into build/ by deploy.sh:
# server.js only needs the two URLs below to build the Content-Security-Policy connect-src.

# Server Configuration
PORT={{ https_port }}
HTTP_REDIRECT={{ http_redirect }}

# SSL Configuration
SSL_KEY_FILE=ssl/{{ windfire_server_key }}
SSL_CRT_FILE=ssl/{{ windfire_server_certificate }}

# Content-Security-Policy connect-src origins
REACT_APP_KEYCLOAK_URL={{ react_app_keycloak_url }}
REACT_APP_RESTAURANTS_URL={{ react_app_restaurants_url }}
{% if keycloak_proxy_target | length > 0 %}

# Keycloak proxy: /keycloak/* is forwarded to this URL
KEYCLOAK_PROXY_TARGET={{ keycloak_proxy_target }}
{% endif %}
